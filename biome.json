{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!drizzle",
      "!dist",
      "!coverage",
      "!.worktrees",
      "!docs/local",
      "!test-results",
      "!evaluation-results",
      "!playwright-report",
      "!**/*.svg",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noComponentHookFactories": "off",
        "usePlaywrightValidDescribeCallback": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
