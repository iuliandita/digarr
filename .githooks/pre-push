#!/usr/bin/env bash
set -euo pipefail

# Check documentation contracts, links, environment names, API routes and pins.
# Activate with: git config --local core.hooksPath .githooks
# CI and release jobs run the same checks.

cd "$(git rev-parse --show-toplevel)"

if command -v bun >/dev/null 2>&1; then
  bun run check:docs
else
  echo "pre-push: bun is required for documentation checks; install it before pushing" >&2
  exit 1
fi
